# jerkai-mcp environment
#
# This slice is deliberately credential-free: the server reads a vendored copy
# of the metric registry and never opens a database connection. There is no
# DATABASE_URL here, and adding one is a scope change, not a config change.

# Path to a local checkout of albimartai/jerkai, used only by
# scripts/check-vendor-drift.mjs to compare the vendored files against the
# commit pinned in vendor.lock.json. Relative paths resolve from the repo root.
JERKAI_REPO=../jerkai
